@'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output
dist/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp

# Local coverage reports
.coverage
htmlcov/

# Local data backups
*.bak
*.old
'@ | Set-Content -Encoding utf8 .gitignore